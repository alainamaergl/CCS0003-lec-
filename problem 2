#include <iostream>
using namespace std;
int main() {

        char operation;
        float num1,num2;
       

        cout << "Enter two numbers: ";
        cin >> num1 >> num2;
        cout << "enter operator ( +, -, *, /):   ";
        cin >> operation;

        switch (operation) {
            case '+':

                cout << "The result of the operation is:  ";
                cout << num1 + num2;
                break;

            case '-':
                cout << "The result of the operation is:   ";
                cout << num1 - num2;
                break;

            case '*':
                cout << "The result of the operation is:   ";
                cout << num1 * num2;
                break;

            case '/':
                cout << "The result of the operation is:   ";  
                cout << num1 / num2;
                break;

            default:
                cout << "Invalid operator";
        }
        return 0;
    }




