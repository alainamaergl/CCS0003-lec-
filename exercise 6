#include <iostream>
#include <iomanip>
using namespace std;
int main()
{
    long long byteCount;
    
    //input
    cout << "enter byte: ";
    cin >> byteCount;
    
    //calculation
    double KB = (byteCount / 1024.0);
    double MB = (KB / 1024.0);
    double GB = (MB / 1024.0);
    
    long long whole_MB = static_cast<long long>(MB);
    
    // output
    
    cout << fixed << setprecision(2);
    cout << "KB: " << KB << endl;
    cout << "MB: " << MB << endl;
    
    cout << fixed << setprecision(4);
    cout << "GB: " << GB << endl;
    cout << "Whole MB: " << whole_MB << endl;

    return 0;
}
